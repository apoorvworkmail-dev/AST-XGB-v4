# ==============================================================================
# AST-XGB Real Estate Platform (GharDhundo) — Production Environment Template
# Safe to commit: Contains no secrets, passwords, or private API keys.
# ==============================================================================

# --- Backend Server Configuration ---
ENV=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- CORS Security Settings ---
# Comma-separated list of allowed origins. Never include '*' in production when credentials are enabled.
CORS_ORIGINS=https://ast-xgb-v4.vercel.app,http://localhost:3000,http://localhost:5173,http://localhost:80

# --- Machine Learning Artifacts Directory ---
MODEL_DIR=models/xgboost_final_v4

# --- Database & Rate Limiting ---
DATABASE_URL=sqlite:///./backend/data/ghardhundo.db
RATE_LIMIT_INQUIRIES_PER_MIN=5

# --- Optional Third-Party Notification Providers (Configure in production host secrets) ---
# SMS_GATEWAY_API_KEY=
# EMAIL_SERVICE_API_KEY=
