# Backend API Base Endpoint (defaults to relative /api/v1 or full URL)
# Local: http://localhost:8000/api/v1
# Production (Render): https://ast-xgb-v4.onrender.com/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Mapping Provider Configuration
# Supported providers: 'carto' (default, free CartoDB Voyager tiles), 'osm' (OpenStreetMap standard tiles)
VITE_MAP_PROVIDER=carto

# Tile Server URL (No secret API key required for open CartoDB Voyager / OpenStreetMap raster tiles)
# CartoDB Voyager: https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
# OpenStreetMap: https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png

# Map Attribution String
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>

# Max Tile Zoom Level
VITE_MAP_MAX_ZOOM=19

# Smart Search & Recommendation Mode
# Value: 'deterministic' (rule-based multi-attribute similarity matching on real listing attributes)
VITE_RECOMMENDATION_ENGINE=deterministic
